{
  "plugins": [
    
    {
      "name": "chord_btc_sl",
      "class": "BTCSLChordPlugin",
      "entrypoint": "src.plugins.chord.btc_sl",
      "display_name": "BTC-SL Chord Recognizer (ChordMini)",
      "version": "2.0.0",
      "input_stems": ["vocals", "drums", "bass", "piano", "guitar", "other"],
      "output": "component_chord_labels",
      "requirements": {
        "gpu_memory_mb": 2048,
        "ram_mb_min": 1024,
        "python_packages": ["torch", "librosa", "numpy"],
        "required_files": [
          "external/chordmini/src/models/common/config.py",
          "external/chordmini/src/models/common/transformer_modules.py",
          "external/chordmini/src/models/common/temporal_smoothing.py",
          "external/chordmini/src/models/btc_model.py",
          "external/chordmini/src/evaluation/utils/common.py",
          "external/chordmini/src/evaluation/utils/inference.py"
        ],
        "required_file_groups": [[
          "external/chordmini/checkpoints/btc_model_large_voca.pt",
          "external/chordmini/checkpoints/btc_model_best.pth"
        ]],
        "asset_setup_hint": "请在项目目录执行 git submodule update --init -- src/plugins/chord/external/chordmini"
      },
      "phase": "post-separation"
    },
    {
      "name": "chord_ismir2019",
      "class": "ISMIR2019ChordPlugin",
      "entrypoint": "src.plugins.chord.ismir2019",
      "display_name": "ISMIR 2019 Chord Recognizer",
      "version": "1.0.0",
      "input_stems": ["vocals", "drums", "bass", "piano", "guitar", "other"],
      "output": "component_chord_labels",
      "requirements": {
        "gpu_memory_mb": 1024,
        "ram_mb_min": 512,
        "python_packages": ["torch", "librosa"]
      },
      "phase": "post-separation"
    }
   
  ]
}
